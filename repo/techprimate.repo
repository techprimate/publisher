# dnf/yum source for the techprimate release registry — source of truth.
# Published verbatim to https://packages.techprimate.com/techprimate.repo by the publisher.
# One section per project that publishes Linux packages. Static binaries use one
# package per $basearch across Fedora, RHEL, AlmaLinux, Rocky Linux, and CentOS.

[techprimate-apple-docs]
name=techprimate - apple-docs
baseurl=https://packages.techprimate.com/apple-docs/rpm/stable/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://packages.techprimate.com/RPM-GPG-KEY-techprimate
